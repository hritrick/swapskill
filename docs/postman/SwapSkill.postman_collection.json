{
  "info": {
    "_postman_id": "swapskill-collection-v1",
    "name": "SwapSkill API",
    "description": "Complete Postman collection for the SwapSkill REST API.\n\nImport the companion environment file (SwapSkill.postman_environment.json) to populate {{baseUrl}} and {{token}}.\n\nThe Login request includes a test script that automatically sets {{token}} for downstream requests — run the Auth folder in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register — success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has token', () => pm.expect(pm.response.json().data.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser_{{$timestamp}}@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register — duplicate email (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('success = false', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Member\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register — validation failure (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has errors array', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-an-email\",\n  \"password\": \"abc\"\n}"
            }
          }
        },
        {
          "name": "Login — success (sets {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has token', () => pm.expect(pm.response.json().data.token).to.be.a('string'));",
                  "// Auto-populate token for downstream requests",
                  "pm.environment.set('token', pm.response.json().data.token);",
                  "pm.environment.set('userId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login — bad password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('success = false', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "Get Me (protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has _id', () => pm.expect(pm.response.json().data._id).to.be.a('string'));",
                  "pm.test('No password field', () => pm.expect(pm.response.json().data.password).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Get Me — unauthenticated (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Change Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401', () => pm.expect([200, 401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/auth/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"password123\",\n  \"confirmNewPassword\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Skills",
      "item": [
        {
          "name": "List skills (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('Has pagination meta', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.page).to.be.a('number');",
                  "  pm.expect(r.totalPages).to.be.a('number');",
                  "  pm.expect(r.totalCount).to.be.a('number');",
                  "});",
                  "// Save a skill ID for downstream tests",
                  "const skills = pm.response.json().data;",
                  "if (skills.length > 0) pm.environment.set('skillId', skills[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/skills?page=1&limit=9",
              "host": ["{{baseUrl}}"],
              "path": ["api", "skills"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "9" }
              ]
            }
          }
        },
        {
          "name": "List skills — filter by category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All results have cat=tech', () => {",
                  "  pm.response.json().data.forEach(s => pm.expect(s.cat).to.equal('tech'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/skills?category=tech",
              "host": ["{{baseUrl}}"],
              "path": ["api", "skills"],
              "query": [{ "key": "category", "value": "tech" }]
            }
          }
        },
        {
          "name": "Get skill by ID — found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has _id', () => pm.expect(pm.response.json().data._id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills/{{skillId}}"
          }
        },
        {
          "name": "Get skill by ID — 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills/000000000000000000000001"
          }
        },
        {
          "name": "Create skill — authenticated (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has _id', () => pm.expect(pm.response.json().data._id).to.be.a('string'));",
                  "pm.environment.set('mySkillId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/skills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman testing tutorial\",\n  \"wants\": \"Docker basics\",\n  \"cat\": \"tech\"\n}"
            }
          }
        },
        {
          "name": "Create skill — unauthenticated (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/skills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail\",\n  \"wants\": \"Nothing\",\n  \"cat\": \"tech\"\n}"
            }
          }
        },
        {
          "name": "Create skill — invalid category (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has errors array', () => pm.expect(pm.response.json().errors).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/skills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Valid title\",\n  \"wants\": \"Valid want\",\n  \"cat\": \"invalid_category\"\n}"
            }
          }
        },
        {
          "name": "Update skill — owner (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title updated', () => pm.expect(pm.response.json().data.title).to.equal('Postman + Newman tutorial'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/skills/{{mySkillId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman + Newman tutorial\"\n}"
            }
          }
        },
        {
          "name": "Delete skill — owner (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/skills/{{mySkillId}}"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users — non-admin (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get user by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('No password', () => pm.expect(pm.response.json().data.password).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Update user — self (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Member Updated\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Swaps",
      "item": [
        {
          "name": "Create swap request (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Status is pending', () => pm.expect(pm.response.json().data.status).to.equal('pending'));",
                  "pm.environment.set('swapId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/swaps",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUser\": \"{{targetUserId}}\",\n  \"skill\": \"{{skillId}}\",\n  \"offeredSkill\": \"Postman testing\",\n  \"hours\": 1\n}"
            }
          }
        },
        {
          "name": "Get my swaps",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/swaps/me"
          }
        },
        {
          "name": "Get my received pending swaps",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All pending', () => pm.response.json().data.forEach(s => pm.expect(s.status).to.equal('pending')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/swaps/me?role=received&status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "swaps", "me"],
              "query": [
                { "key": "role", "value": "received" },
                { "key": "status", "value": "pending" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.equal('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
